# Configuración de Firebase
FIREBASE_DATABASE_URL=https://TU_PROYECTO.firebaseio.com

# --- ELIGE UNA DE LAS DOS OPCIONES SEGÚN EL ENTORNO ---

# OPCIÓN 1 - Local / Docker: ruta al archivo JSON
# FIREBASE_SERVICE_ACCOUNT_PATH=./keys/iotKey.json

# OPCIÓN 2 - Railway / Render / fly.io: el JSON en base64
# Genera el valor con: cat keys/iotKey.json | base64
# FIREBASE_KEY_BASE64=eyJ0eXBlIjoic2Vydm...

# Configuración del Servidor
PORT=3000
